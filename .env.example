# Web / Health Server Port (Defaults to 3000 or NexusHost assigned port)
PORT=3000

# Discord Bot Credentials (from Discord Developer Portal)
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=1477986624687177910

# Turso Cloud Database Credentials (Required for cloud storage)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional Configurations
INVESTOR_ROLE_ID=
BACKUP_CHANNEL_ID=
